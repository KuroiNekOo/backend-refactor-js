generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  output        = "./generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserCompanyStatus {
  OWNER
  EMPLOYEE
}

enum TransactionStatus {
  SUCCESS
  ERROR
}

enum BankAccountTypes {
  STANDARD
  PREMIUM
}

enum BankAccountOwnerTypes {
  USER
  COMPANY
}

enum ChunkStatus {
  SOLD
  ON_SALE
  EXPIRED
}

// Models
model User {
  id           String        @id @default(uuid())
  name         String        @map("name") @db.VarChar(36)
  password     String?       @map("password") @db.VarChar(64)
  bankAccounts BankAccount[] @relation("UserBankAccounts")
  // bankAccountId String?       @map("bank_account_id") @db.VarChar(36)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  userCompanies   UserCompany[]
  userRoles       UserRole[]
  userPermissions UserPermission[]
  drivePurchases  DrivePurchase[]

  @@map("user")
}

model Company {
  id                 String              @id @default(uuid())
  name               String              @map("name") @db.VarChar(64)
  level              Int                 @default(1) @map("level")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  userCompanies      UserCompany[]
  bankAccounts       BankAccount[]       @relation("CompanyBankAccounts")
  containerContents  ContainersContent[]
  containerHistories ContainerHistory[]
  chunkSolds         ChunkSold[]

  @@map("company")
}

model UserCompany {
  userId    String            @map("user_id") @db.VarChar(36)
  companyId String            @map("company_id") @db.VarChar(36)
  status    UserCompanyStatus @default(OWNER) @map("status")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User              @relation(fields: [userId], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])

  @@id([userId, companyId])
  @@map("user_company")
}

model BankAccount {
  id                     String                @id @db.VarChar(8)
  userId                 String?               @map("user_id") @db.VarChar(36)
  companyId              String?               @map("company_id") @db.VarChar(36)
  ownerType              BankAccountOwnerTypes @map("owner_type")
  bankAccountTypeId      Int                   @map("bank_account_type_id")
  isDefault              Boolean               @default(false) @map("is_default")
  balance                Float                 @default(0) @map("balance")
  isActive               Boolean               @default(true) @map("is_active")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  user                   User?                 @relation("UserBankAccounts", fields: [userId], references: [id])
  company                Company?              @relation("CompanyBankAccounts", fields: [companyId], references: [id])
  type                   BankAccountType       @relation(fields: [bankAccountTypeId], references: [id])
  transactionsAsSender   Transaction[]         @relation("Sender")
  transactionsAsReceiver Transaction[]         @relation("Receiver")

  @@map("bank_account")
}

model BankAccountType {
  id           Int              @id @default(autoincrement())
  name         BankAccountTypes @unique @default(STANDARD) @map("name")
  limit        Float            @default(5000) @map("limit")
  interestRate Float            @default(0.05) @map("interest_rate")
  bankAccounts BankAccount[]

  @@map("bank_account_type")
}

model Transaction {
  id         Int               @id @default(autoincrement())
  senderId   String            @map("sender_id") @db.VarChar(36)
  receiverId String            @map("receiver_id") @db.VarChar(36)
  amount     Float             @default(0) @map("amount")
  status     TransactionStatus @default(SUCCESS) @map("status")
  inProgress Boolean           @default(false) @map("in_progress")
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  sender     BankAccount       @relation("Sender", fields: [senderId], references: [id])
  receiver   BankAccount       @relation("Receiver", fields: [receiverId], references: [id])

  @@map("transaction")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @map("name") @db.VarChar(32)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model UserRole {
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    Int      @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @map("name") @db.VarChar(32)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@map("permission")
}

model UserPermission {
  userId       String     @map("user_id") @db.VarChar(36)
  permissionId Int        @map("permission_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
  @@map("user_permission")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model Drive {
  id             Int             @id @default(autoincrement())
  name           String          @map("name") @db.VarChar(32)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  drivePurchases DrivePurchase[]

  @@map("drive")
}

model DrivePurchase {
  id        Int                      @id @default(autoincrement())
  driveId   Int                      @map("drive_id")
  userId    String                   @map("user_id") @db.VarChar(36)
  content   Json?                    @map("content") @db.Json
  isActive  Boolean                  @default(true) @map("is_active")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")
  drive     Drive                    @relation(fields: [driveId], references: [id])
  user      User                     @relation(fields: [userId], references: [id])
  items     DrivePurchaseItemBlock[] @relation("DrivePurchaseItems")

  @@map("drive_purchase")
}

model DrivePurchaseItemBlock {
  drivePurchaseId Int           @map("drive_purchase_id")
  itemBlockId     Int           @map("item_block_id")
  quantity        Int           @map("quantity")
  content         Json?         @map("content") @db.Json
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  drivePurchase   DrivePurchase @relation("DrivePurchaseItems", fields: [drivePurchaseId], references: [id])
  itemBlock       ItemBlock     @relation("ItemBlockPurchases", fields: [itemBlockId], references: [id])

  @@id([drivePurchaseId, itemBlockId])
  @@map("drive_purchase_has_item_block")
}

model Container {
  id                 Int                @id @default(autoincrement())
  name               String             @map("name") @db.VarChar(32)
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  content            ContainersContent?
  containerHistories ContainerHistory[]

  @@map("container")
}

model ContainersContent {
  id          Int       @id @default(autoincrement())
  containerId Int       @unique @map("container_id")
  companyId   String    @map("company_id") @db.VarChar(36)
  content     Json?     @map("content") @db.Json
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  container   Container @relation(fields: [containerId], references: [id])
  company     Company   @relation(fields: [companyId], references: [id])

  @@map("container_content")
}

model ItemBlock {
  id           Int                      @id @default(autoincrement())
  minecraftId  String                   @map("minecraft_id") @db.VarChar(64)
  content      Json?                    @map("content") @db.Json
  isInDrive    Boolean                  @default(false) @map("is_in_drive")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  marketPrices MarketPrice?             @relation
  purchases    DrivePurchaseItemBlock[] @relation("ItemBlockPurchases")

  @@map("item_block")
}

model MarketPrice {
  id                   Int                  @id @default(autoincrement())
  itemBlockId          Int                  @unique @map("item_block_id")
  price                Float                @map("price")
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  itemBlock            ItemBlock            @relation(fields: [itemBlockId], references: [id])
  marketPriceHistories MarketPriceHistory[]

  @@map("market_price")
}

model MarketPriceHistory {
  id            Int         @id @default(autoincrement())
  marketPriceId Int         @map("market_price_id")
  price         Float       @map("price")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  marketPrice   MarketPrice @relation(fields: [marketPriceId], references: [id])

  @@map("market_price_history")
}

model SettingsPrice {
  id          String   @id @db.VarChar(32)
  value       Float    @default(0) @map("value")
  description String   @map("description") @db.VarChar(1024)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings_price")
}

model ContainerHistory {
  id          Int       @id @default(autoincrement())
  containerId Int       @map("container_id")
  companyId   String    @map("company_id") @db.VarChar(36)
  content     Json?     @map("content") @db.Json
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  container   Container @relation(fields: [containerId], references: [id])
  company     Company   @relation(fields: [companyId], references: [id])

  @@map("container_history")
}

model Chunk {
  id           Int         @id @default(autoincrement())
  x            Int         @map("x")
  z            Int         @map("z")
  xPrime       Int         @map("x_prime")
  zPrime       Int         @map("z_prime")
  height       Int?        @map("height")
  depth        Int?        @map("depth")
  worldId      Int         @map("world_id")
  defaultPrice Float       @default(15000) @map("default_price")
  status       ChunkStatus @default(ON_SALE) @map("status")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  endDate      DateTime    @default(now()) @map("end_date")
  chunkSolds   ChunkSold[]
  world        World       @relation(fields: [worldId], references: [id])

  @@map("chunk")
}

model ChunkSold {
  chunkId   Int      @map("chunk_id")
  companyId String   @map("company_id") @db.VarChar(36)
  price     Float    @map("price")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  chunk     Chunk    @relation(fields: [chunkId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@id([chunkId, companyId])
  @@map("chunk_sold")
}

model World {
  id        Int      @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  chunks    Chunk[]

  @@map("world")
}