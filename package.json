{
  "name": "backend-luxentis",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node ./src/server.js",
    "dev": "NODE_ENV=development node --watch ./src/server.js",
    "db:format": "prisma format",
    "db:first": "prisma migrate dev --create-only --name init",
    "db:create-migration": "prisma migrate dev --create-only --name",
    "db:deploy": "prisma migrate deploy && npm run db:seeding",
    "db:client-generate": "prisma generate",
    "db:clean": "prisma migrate reset --force",
    "db:seeding": "node ./prisma/scripts/seeding.js",
    "db:reset": "npm run db:clean && npm run db:deploy && npm run db:client-generate",
    "db:force-reset": "rm -rf ./prisma/migrations && npm run db:first && npm run db:clean && npm run db:deploy && npm run db:client-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.0",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "http-status-codes": "^2.3.0",
    "randexp": "^0.5.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "prettier": "^3.0.0",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^1.0.0"
  }
}
